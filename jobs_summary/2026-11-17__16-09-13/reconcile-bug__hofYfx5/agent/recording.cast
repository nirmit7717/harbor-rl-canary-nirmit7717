[5.582455, "o", "#!/usr/bin/env python3\r\n\"\"\"Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON.\"\"\"\r\n\r\nimport csv\r\nimport sys\r\nfrom datetime import datetime\r\nfrom decimal import MAX_PREC, ROUND_HALF_UP, Decimal, DecimalException, localcontext\r\nfrom pathlib import Path\r\n\r\nREQUIRED_COLUMNS = (\"tx_id\", \"timestamp\", \"amount\", \"status\")\r\nKNOWN_STATUSES = {\"VALID\", \"FAILED\", \"PENDING\"}\r\n\r\n\r\ndef parse_timestamp(value):\r\n    parsed = datetime.fromisoformat(value)\r\n    if parsed.tzinfo is None:\r\n        raise ValueError(f\"Timestamp must include a UTC offset: {value!r}\")\r\n    return parsed\r\n\r\n\r\ndef parse_amount(value):\r\n    try:\r\n        amount = Decimal(value)\r\n    except DecimalException:\r\n        raise ValueError(f\"Invalid amount: {value!r}\") from None\r\n    if not amount.is_finite():\r\n        raise ValueError(f\"Amount must be finite: {value!r}\")\r\n    return amount\r\n\r\n\r\ndef reconcile(csv_path):\r\n    latest = {}\r\n    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle:\r\n        reader = csv.DictReader(handle)\r\n        if not set(REQUIRED_COLUMNS).issubset(reader.fieldnames or []):\r\n            raise ValueError(\"CSV is missing required columns\")\r\n\r\n        for row in reader:\r\n            if None in row or None in row.values():\r\n                raise ValueError(f\"Malformed row on line {reader.line_num}\")\r\n            tx_id = row[\"tx_id\"].strip()\r\n            timestamp = row[\"timestamp\"].strip()\r\n            parse_timestamp(timestamp)\r\n            amount = parse_amount(row[\"amount\"].strip())\r\n            status = row[\"status\"].strip().upper()\r\n\r\n            if not tx_id:\r\n                raise ValueError(f\"Empty transaction ID on line {reader.line_num}\")\r\n            if status not in KNOWN_STATUSES:\r\n                raise ValueError(f\"Unknown status on line {reader.line_num}: {status!r}\")\r\n\r\n            # Keep the most recent record for each transaction ID.\r\n            previous = latest.get(tx_id)\r\n            if previous is None or timestamp > previous[\"timestamp\"]:\r\n                latest[tx_id] = {\"timestamp\": timestamp, \"amount\": amount, \"status\": status}\r\n\r\n    valid = [tx for tx in latest.values() if tx[\"status\"] in (\"VALID\", \"PENDING\")]\r\n    failed = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\r\n    with localcontext(prec=MAX_PREC):\r\n        total = sum((tx[\"amount\"] for tx in valid), Decimal(0))\r\n        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\r\n    if total.is_zero():\r\n        total = total.copy_abs()  # never report negative zero\r\n    return total, len(valid), len(failed)\r\n\r\n\r\ndef main():\r\n    if len(sys.argv) != 3:\r\n        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\r\n        sys.exit(1)\r\n    csv_path = Path(sys.argv[1])\r\n    if not csv_path.is_file():\r\n        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    try:\r\n        total, valid_count, failed_count = reconcile(csv_path)\r\n    except (ValueError, DecimalException, OSError, csv.Error) as error:\r\n        print(f\"Error processing CSV: {error}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    # JSON is written by hand so the Decimal total never passes through float.\r\n    print(f'{{\\n  \"total_valid_amount\": {total:f},\\n  \"valid_count\": {valid_count},'\r\n          f'\\n  \"failed_count\": {failed_count}\\n}}')\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[5.582721, "o", "\u001b[?2004hroot@9265bb22e631:/app# "]
[49.054865, "i", "cat > reconcile.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON.\"\"\"\n\nimport csv\nimport sys\nfrom datetime import datetime\nfrom decimal import ROUND_HALF_UP, Decimal, DecimalException, localcontext\nfrom pathlib import Path\n\nREQUIRED_COLUMNS = (\"tx_id\", \"timestamp\", \"amount\", \"status\")\nKNOWN_STATUSES = {\"VALID\", \"FAILED\", \"PENDING\"}\n\n\ndef parse_timestamp(value):\n    try:\n        parsed = datetime.fromisoformat(value)\n    except (ValueError, TypeError):\n        raise ValueError(f\"Invalid ISO 8601 timestamp: {value!r}\")\n    if parsed.tzinfo is None:\n        raise ValueError(f\"Timestamp must include a UTC offset: {value!r}\")\n    return parsed\n\n\ndef parse_amount(value):\n    try:\n        amount = Decimal(value)\n    except DecimalException:\n        raise ValueError(f\"Invalid amount: {value!r}\") from None\n    if not amount.is_finite():\n        raise ValueError(f\"Amount must be finite: {value!r}\")\n    return amount\n\n\ndef reconcile(csv_path):\n    latest = {}\n    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle:\n        # Read raw header and rows to validate exact field count and header\n        reader = csv.reader(handle)\n        try:\n            header = next(reader)\n        except StopIteration:\n            raise ValueError(\"CSV file is empty\")\n        \n        if tuple(header) != REQUIRED_COLUMNS:\n            raise ValueError(f\"Invalid CSV header: {header}\")\n\n        for line_num, row in enumerate(reader, start=2):\n            if len(row) != len(REQUIRED_COLUMNS):\n                raise ValueError(f\"Row on line {line_num} does not contain exactly {len(REQUIRED_COLUMNS)} fields\")\n            \n            tx_id_raw, timestamp_raw, amount_raw, status_raw = row\n            \n            tx_id = tx_id_raw.strip()\n            if not tx_id:\n                raise ValueError(f\"Empty transaction ID on line {line_num}\")\n                \n            dt = parse_timestamp(timestamp_raw.strip())\n            amount = parse_amount(amount_raw.strip())\n            \n            status = status_raw.strip().upper()\n            if not status or status not in KNOWN_STATUSES:\n                raise ValueError(f\"Unknown or empty status on line {line_num}: {status_raw!r}\")\n\n            # Keep most recent record. If same point in time, keep first encountered.\n            if tx_id not in latest:\n                latest[tx_id] = {\"timestamp\": dt, \"amount\": amount, \"status\": status}\n            else:\n                if dt > latest[tx_id][\"timestamp\"]:\n                    latest[tx_id] = {\"timestamp\": dt, \"amount\": amount, \"status\": status}\n\n    valid_txs = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\n    failed_txs = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\n\n    with localcontext():\n        total = sum((tx[\"amount\" for tx in valid_txs], Decimal(0))\n        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n        if total.is_zero():\n            total = total.copy_abs()  # avoid negative zero\n            \n    return total, len(valid_txs), len(failed_txs)\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\n        sys.exit(1)\n    csv_path = Path(sys.argv[1])\n    if not csv_path.is_file():\n        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\n        sys.exit(1)\n    try:\n        total, valid_count, failed_count = reconcile(csv_path)\n    except (ValueError, DecimalException, OSError, csv.Error) as error:\n        print(f\"Error: {error}\", file=sys.stderr)\n        sys.exit(1)\n    \n    print(f'{\\n  \"total_valid_amount\": {total:f},\\n  \"valid_count\": {valid_count},'\\\n          f'\\n  \"failed_count\": {failed_count}\\n}')\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
