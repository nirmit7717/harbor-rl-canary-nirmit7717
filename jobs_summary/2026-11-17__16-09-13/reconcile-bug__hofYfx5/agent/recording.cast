[64.486668, "o", "    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle:\r\n\u001b[?2004l\r"]
[64.486708, "o", "\u001b[?2004h>         reader = csv.reader(handle)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.486911, "o", "            header = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>         except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.487016, "o", "            raise ValueError(\"CSV file is empty\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.487106, "o", "        if tuple(header) != REQUIRED_COLUMNS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.487251, "o", "            raise ValueError(f\"Invalid CSV header: {header}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.487385, "o", "        for line_num, row in enumerate(reader, start=2):\r\n\u001b[?2004l\r\u001b[?2004h>             if len(row) != len(REQUIRED_COLUMNS):\r\n\u001b[?2004l\r"]
[64.487493, "o", "\u001b[?2004h> "]
[64.487637, "o", "                raise ValueError(f\"Row on line {line_num} does not contain exactly {len(REQUIRED_COLUMNS)} fields\")\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.487785, "o", "            tx_id_raw, timestamp_raw, amount_raw, status_raw = row\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[64.488008, "o", ">             tx_id = tx_id_raw.strip()\r\n\u001b[?2004l\r\u001b[?2004h>             if not tx_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.488074, "o", "                raise ValueError(f\"Empty transaction ID on line {line_num}\")\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>             dt = parse_timestamp(timestamp_raw.strip())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.488198, "o", "            amount = parse_amount(amount_raw.strip())\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.488417, "o", "            status = status_raw.strip().upper()\r\n\u001b[?2004l\r\u001b[?2004h>             if not status or status not in KNOWN_STATUSES:\r\n\u001b[?2004l\r"]
[64.488536, "o", "\u001b[?2004h>                 raise ValueError(f\"Unknown or empty status on line {line_num}: {status_raw!r}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.488711, "o", "            # Keep most recent record. If same point in time, keep first encountered.\r\n\u001b[?2004l\r\u001b[?2004h>             if tx_id not in latest:\r\n\u001b[?2004l\r\u001b[?2004h>                 latest[tx_id] = {\"timestamp\": dt, \"amount\": amount, \"status\": status}\r\n\u001b[?2004l\r"]
[64.488911, "o", "\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 if dt > latest[tx_id][\"timestamp\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.489072, "o", "                    latest[tx_id] = {\"timestamp\": dt, \"amount\": amount, \"status\": status}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     valid_txs = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\r\n\u001b[?2004l\r"]
[64.489148, "o", "\u001b[?2004h>     failed_txs = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[64.489259, "o", "> "]
[64.48939, "o", "    with localcontext():\r\n\u001b[?2004l\r\u001b[?2004h>         total = sum((tx[\"amount\"] for tx in valid_txs), Decimal(0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.489462, "o", "        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\r\n\u001b[?2004l\r\u001b[?2004h>         if total.is_zero():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.489632, "o", "            total = total.copy_abs()\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[64.489755, "o", "\u001b[?2004h>     return total, len(valid_txs), len(failed_txs)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.489873, "o", ">     if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[64.489967, "o", "\u001b[?2004h> "]
[64.490021, "o", "        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490094, "o", "    csv_path = Path(sys.argv[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490215, "o", "    if not csv_path.is_file():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490334, "o", "        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490399, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h>         total, valid_count, failed_count = reconcile(csv_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490449, "o", "    except (ValueError, DecimalException, OSError, csv.Error) as error:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.490684, "o", "        print(f\"Error: {error}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.490716, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\r\n\u001b[?2004l\r\u001b[?2004h>         f'{{\\n'\r\n\u001b[?2004l\r\u001b[?2004h>         f'  \"total_valid_amount\": {total:f},\\n'\r\n\u001b[?2004l\r"]
[64.490959, "o", "\u001b[?2004h>         f'  \"valid_count\": {valid_count},\\n'\r\n\u001b[?2004l\r\u001b[?2004h>         f'  \"failed_count\": {failed_count}\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
