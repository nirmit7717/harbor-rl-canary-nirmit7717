[?2004l[?2004h> 
[?2004l[?2004h> def reconcile(csv_path):
[?2004l[?2004h>     latest = {}
[?2004l[?2004h>     with open(csv_path, newline="", encoding="utf-8-sig") as handle:
[?2004l[?2004h>         reader = csv.reader(handle)
[?2004l[?2004h>         header = next(reader, None)
[?2004l[?2004h>         if header is None:
[?2004l[?2004h>             raise ValueError("CSV file is empty")
[?2004l[?2004h>         
[?2004l[?2004h>         header = [h.strip() for h in header]
[?2004l[?2004h>         if not set(REQUIRED_COLUMNS).issubset(header):
[?2004l[?2004h>             raise ValueError("CSV is missing required columns")
[?2004l[?2004h>         
[?2004l[?2004h>         header_len = len(header)
[?2004l[?2004h> 
[?2004l[?2004h>         for line_num, row in enumerate(reader, start=2):
[?2004l[?2004h>             if len(row) != header_len:
[?2004l[?2004h>                 raise ValueError(f"Row {line_num} has {len(row)} fields, expected {header_len}")
[?2004l[?2004h>             
[?2004l[?2004h>             row_dict = dict(zip(header, row))
[?2004l[?2004h>             tx_id = row_dict["tx_id"].strip()
[?2004l[?2004h>             if not tx_id:
[?2004l[?2004h>                 raise ValueError(f"Empty transaction ID on line {line_num}")
[?2004l[?2004h>             
[?2004l[?2004h>             timestamp_str = row_dict["timestamp"].strip()
[?2004l[?2004h>             dt = parse_timestamp(timestamp_str)
[?2004l[?2004h>             
[?2004l[?2004h>             amount = parse_amount(row_dict["amount"].strip())
[?2004l[?2004h>             status = row_dict["status"].strip().upper()
[?2004l[?2004h>             if not status:
[?2004l[?2004h>                 raise ValueError(f"Empty status on line {line_num}")
[?2004l[?2004h>             if status not in KNOWN_STATUSES:
[?2004l[?2004h>                 raise ValueError(f"Unknown status on line {line_num}: {status!r}")
[?2004l[?2004h> 
[?2004l[?2004h>             previous = latest.get(tx_id)
[?2004l[?2004h>             if previous is None:
[?2004l[?2004h>                 latest[tx_id] = {"dt": dt, "amount": amount, "status": status}
[?2004l[?2004h>             else:
[?2004l[?2004h>                 if dt > previous["dt"]:
[?2004l[?2004h>                     latest[tx_id] = {"dt": dt, "amount": amount, "status": status}
[?2004l[?2004h>                 elif dt == previous["dt"]:
[?2004l[?2004h>                     pass
[?2004l[?2004h> 
[?2004l[?2004h>     valid_txs = [tx for tx in latest.values() if tx["status"] == "VALID"]
[?2004l[?2004h>     failed_txs = [tx for tx in latest.values() if tx["status"] == "FAILED"]
[?2004l[?2004h> 
[?2004l[?2004h>     with localcontext(prec=MAX_PREC):
[?2004l[?2004h>         total = sum((tx["amount"] for tx in valid_txs), Decimal(0))
[?2004l[?2004h>         total = total.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
[?2004l[?2004h> 
[?2004l[?2004h>     if total.is_zero():
[?2004l[?2004h>         total = total.copy_abs()
[?2004l[?2004h> 
[?2004l[?2004h>     return total, len(valid_txs), len(failed_txs)
