[210.662466, "i", "cat > test_reconcile.py <<'EOF'\nimport subprocess\nimport sys\nimport tempfile\nimport os\n\ndef run_test(name, csv_content, expected_output=None, expected_ret=0):\n    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv', encoding='utf-8') as f:\n        f.write(csv_content)\n        fname = f.name\n    try:\n        res = subprocess.run([sys.executable, 'reconcile.py', fname], capture_output=True, text=True)\n        if res.returncode != expected_ret:\n            print(f\"FAIL {name}: expected ret {expected_ret}, got {res.returncode}. stderr: {res.stderr}\")\n            return False\n        if expected_ret == 0:\n            import json\n            out = json.loads(res.stdout)\n            if out != expected_output:\n                print(f\"FAIL {name}: expected {expected_output}, got {out}\")\n                return False\n        print(f\"PASS {name}\")\n        return True\n    finally:\n        os.unlink(fname)\n\n# 1. Basic test\nrun_test(\"basic\", \"\"\"tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00Z,100.00,VALID\nt2,2023-01-01T00:00:00Z,50.00,FAILED\nt3,2023-01-01T00:00:00Z,200.00,PENDING\n\"\"\", {\"total_valid_amount\": 100.0, \"valid_count\": 1, \"failed_count\": 1})\n\n# 2. Deduplication with different timestamps\nrun_test(\"dedup_recent\", \"\"\"tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00Z,100.00,VALID\nt1,2023-01-01T01:00:00Z,150.00,VALID\n\"\"\", {\"total_valid_amount\": 150.0, \"valid_count\": 1, \"failed_count\": 0})\n\n# 3. Timezone comparison (different offsets pointing to same time -> keep first)\nrun_test(\n    \"dedup_same_time_diff_offset\",\n    \"tx_id,timestamp,amount,status\\n\"\n    \"t1,2023-01-01T02:00:00+02:00,100.00,VALID\\n\"\n    \"t1,2023-01-01T00:00:00Z,200.00,VALID\\n\",\n    {\"total_valid_amount\": 100.0, \"valid_count\": 1, \"failed_count\": 0}\n)\n\n# 4. Status case insensitivity and whitespace\nrun_test(\n    \"status_formatting\",\n    \"tx_id,timestamp,amount,status\\n\"\n    \"t1,2023-01-01T00:00:00Z,10.50,  valid  \\n\"\n    \"t2,2023-01-01T00:00:00Z,20.00, failed \\n\"\n    \"t3,2023-01-01T00:00:00Z,30.00, pending \\n\",\n    {\"total_valid_amount\": 10.5, \"valid_count\": 1, \"failed_count\": 1}\n)\n\n# 5. Rounding half up away from zero\nrun_test(\n    \"rounding\",\n    \"tx_id,timestamp,amount,status\\n\"\n    \"t1,2023-01-01T00:00:00Z,2.345,VALID\\n\"\n    \"t2,2023-01-01T00:00:00Z,-2.345,VALID\\n\",\n    {\"total_valid_amount\": 0.0, \"valid_count\": 2, \"failed_count\": 0}\n)\n\n# 6. Negative zero check\nrun_test(\n    \"zero_amount\",\n    \"tx_id,timestamp,amount,status\\n\"\n    \"t1,2023-01-01T00:00:00Z,0.00,VALID\\n\",\n    {\"total_valid_amount\": 0.0, \"valid_count\": 1, \"failed_count\": 0}\n)\n\n# 7. Invalid validations (should exit non-zero)\nrun_test(\"invalid_timestamp_no_tz\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00,100.00,VALID\\n\", expected_ret=1)\nrun_test(\"invalid_amount_nan\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,NaN,VALID\\n\", expected_ret=1)\nrun_test(\"unknown_status\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,100.00,UNKNOWN\\n\", expected_ret=1)\nrun_test(\"missing_columns\", \"id,time,val,stat\\nt1,2023-01-01T00:00:00Z,100.00,VALID\\n\", expected_ret=1)\nrun_test(\"empty_tx_id\", \"tx_id,timestamp,amount,status\\n,2023-01-01T00:00:00Z,100.00,VALID\\n\", expected_ret=1)\nrun_test(\"extra_fields\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,100.00,VALID,EXTRA\\n\", expected_ret=1)\n\nEOF\npython3 test_reconcile.py\n"]
[210.662741, "o", "cat > test_reconcile.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.662919, "o", "import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r"]
[210.663064, "o", "\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_test(name, csv_content, expected_output=None, expected_ret=0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.663259, "o", "    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(csv_content)\r\n\u001b[?2004l\r\u001b[?2004h>         fname = f.name\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[210.663452, "o", "\u001b[?2004h> "]
[210.663529, "o", "        res = subprocess.run([sys.executable, 'reconcile.py', fname], capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h>         if res.returncode != expected_ret:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.66374, "o", "            print(f\"FAIL {name}: expected ret {expected_ret}, got {res.returncode}. stderr: {res.stderr}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.663799, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h>         if expected_ret == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             import json\r\n\u001b[?2004l\r"]
[210.663824, "o", "\u001b[?2004h> "]
[210.664126, "o", "            out = json.loads(res.stdout)\r\n\u001b[?2004l\r\u001b[?2004h>             if out != expected_output:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f\"FAIL {name}: expected {expected_output}, got {out}\")\r\n\u001b[?2004l\r"]
[210.664339, "o", "\u001b[?2004h>                 return False\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"PASS {name}\")\r\n\u001b[?2004l\r\u001b[?2004h>         return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.664435, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h>         os.unlink(fname)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.664614, "o", "# 1. Basic test\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\"basic\", \"\"\"tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.664773, "o", "t1,2023-01-01T00:00:00Z,100.00,VALID\r\n\u001b[?2004l\r\u001b[?2004h> t2,2023-01-01T00:00:00Z,50.00,FAILED\r\n\u001b[?2004l\r"]
[210.664996, "o", "\u001b[?2004h> t3,2023-01-01T00:00:00Z,200.00,PENDING\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\", {\"total_valid_amount\": 100.0, \"valid_count\": 1, \"failed_count\": 1})\r\n\u001b[?2004l\r"]
[210.665104, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.665263, "o", "# 2. Deduplication with different timestamps\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\"dedup_recent\", \"\"\"tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.66543, "o", "t1,2023-01-01T00:00:00Z,100.00,VALID\r\n\u001b[?2004l\r\u001b[?2004h> t1,2023-01-01T01:00:00Z,150.00,VALID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.665692, "o", "\"\"\", {\"total_valid_amount\": 150.0, \"valid_count\": 1, \"failed_count\": 0})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. Timezone comparison (different offsets pointing to same time -> keep first)\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\r\n\u001b[?2004l\r"]
[210.665889, "o", "\u001b[?2004h>     \"dedup_same_time_diff_offset\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"tx_id,timestamp,amount,status\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     \"t1,2023-01-01T02:00:00+02:00,100.00,VALID\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666028, "o", "    \"t1,2023-01-01T00:00:00Z,200.00,VALID\\n\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666156, "o", "    {\"total_valid_amount\": 100.0, \"valid_count\": 1, \"failed_count\": 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666273, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 4. Status case insensitivity and whitespace\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\r\n\u001b[?2004l\r\u001b[?2004h>     \"status_formatting\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666419, "o", "    \"tx_id,timestamp,amount,status\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     \"t1,2023-01-01T00:00:00Z,10.50,  valid  \\n\"\r\n\u001b[?2004l\r"]
[210.666541, "o", "\u001b[?2004h>     \"t2,2023-01-01T00:00:00Z,20.00, failed \\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666703, "o", "    \"t3,2023-01-01T00:00:00Z,30.00, pending \\n\",\r\n\u001b[?2004l\r\u001b[?2004h>     {\"total_valid_amount\": 10.5, \"valid_count\": 1, \"failed_count\": 1}\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666847, "o", "# 5. Rounding half up away from zero\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\r\n\u001b[?2004l\r\u001b[?2004h>     \"rounding\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"tx_id,timestamp,amount,status\\n\"\r\n\u001b[?2004l\r"]
[210.666898, "o", "\u001b[?2004h>     \"t1,2023-01-01T00:00:00Z,2.345,VALID\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.666977, "o", "    \"t2,2023-01-01T00:00:00Z,-2.345,VALID\\n\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.66711, "o", "    {\"total_valid_amount\": 0.0, \"valid_count\": 2, \"failed_count\": 0}\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.667236, "o", "# 6. Negative zero check\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\r\n\u001b[?2004l\r\u001b[?2004h>     \"zero_amount\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.667399, "o", "    \"tx_id,timestamp,amount,status\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     \"t1,2023-01-01T00:00:00Z,0.00,VALID\\n\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.667541, "o", "    {\"total_valid_amount\": 0.0, \"valid_count\": 1, \"failed_count\": 0}\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[210.667648, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.667832, "o", "# 7. Invalid validations (should exit non-zero)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.667989, "o", "run_test(\"invalid_timestamp_no_tz\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00,100.00,VALID\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.668255, "o", "run_test(\"invalid_amount_nan\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,NaN,VALID\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h> run_test(\"unknown_status\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,100.00,UNKNOWN\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.668369, "o", "> run_test(\"missing_columns\", \"id,time,val,stat\\nt1,2023-01-01T00:00:00Z,100.00,VALID\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.66851, "o", "run_test(\"empty_tx_id\", \"tx_id,timestamp,amount,status\\n,2023-01-01T00:00:00Z,100.00,VALID\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.668671, "o", "run_test(\"extra_fields\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,100.00,VALID,EXTRA\\n\", expected_ret=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
