[114.692783, "i", "cat > test_reconcile.py <<'EOF'\nimport subprocess\nimport sys\nimport tempfile\nimport os\n\ndef run_test(name, csv_content, expected_output=None, expected_ret=0):\n    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv') as f:\n        f.write(csv_content)\n        fname = f.name\n    try:\n        res = subprocess.run([sys.executable, 'reconcile.py', fname], capture_output=True, text=True)\n        if res.returncode != expected_ret:\n            print(f\"FAIL {name}: expected ret {expected_ret}, got {res.returncode}. stderr: {res.stderr}\")\n            return False\n        if expected_ret == 0:\n            import json\n            out = json.loads(res.stdout)\n            if out != expected_output:\n                print(f\"FAIL {name}: expected {expected_output}, got {out}\")\n                return False\n        print(f\"PASS {name}\")\n        return True\n    finally:\n        os.unlink(fname)\n\nrun_test(\"basic\", \"tx_id,timestamp,amount,status\\nt1,2023-01-01T00:00:00Z,100.00,VALID\\nt2,2023-01-01T00:00:00Z,50.00,FAILED\\nt3,2023-01-01T00:00:00Z,200.00,PENDING\\n\", {\"total_valid_amount\": 100.0, \"valid_count\": 1, \"failed_count\": 1})\nEOF\npython3 test_reconcile.py\n"]
