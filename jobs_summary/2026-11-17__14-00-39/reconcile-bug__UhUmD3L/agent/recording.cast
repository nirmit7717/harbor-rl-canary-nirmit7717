[104.048183, "i", "cat << 'EOF' > test_edge_cases.py\nimport subprocess\nimport tempfile\nimport os\n\ndef run_csv(content):\n    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv') as f:\n        f.write(content)\n        fname = f.name\n    try:\n        res = subprocess.run(['python3', 'reconcile.py', fname], capture_output=True, text=True)\n        return res.returncode, res.stdout, res.stderr\n    finally:\n        os.unlink(fname)\n\ncode, out, err = run_csv(\"tx_id,timestamp,amount,status\\ntx1,2020-01-01T10:00:00+00:00,-2.345,VALID\")\nprint(\"Test 1 (-2.345):\", code, out.strip(), err.strip())\n\ncode, out, err = run_csv(\"tx_id,timestamp,amount,status\\ntx1,2020-01-01T10:00:00+00:00,10.00,VALID\\ntx1,2020-01-01T05:00:00-05:00,20.00,VALID\")\nprint(\"Test 2 (same point in time tie-break):\", code, out.strip(), err.strip())\n\ncode, out, err = run_csv(\"tx_id,timestamp,amount,status\\ntx1,2020-01-01T10:00:00,10.00,VALID\")\nprint(\"Test 3 (missing tz):\", code, err.strip())\n\ncode, out, err = run_csv(\"tx_id,timestamp,amount,status\\ntx1,2020-01-01T10:00:00+00:00,10.00,VALID,extra\")\nprint(\"Test 4 (extra field):\", code, err.strip())\nEOF\npython3 test_edge_cases.py\n"]
[104.048632, "o", "cat << 'EOF' > test_edge_cases.py\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
