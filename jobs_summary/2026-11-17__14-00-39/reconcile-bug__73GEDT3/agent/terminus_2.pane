[?2004l#!/usr/bin/env python3
"""Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON."""

import csv
import sys
from datetime import datetime
from decimal import MAX_PREC, ROUND_HALF_UP, Decimal, DecimalException, localcontext
from pathlib import Path

REQUIRED_COLUMNS = ("tx_id", "timestamp", "amount", "status")
KNOWN_STATUSES = {"VALID", "FAILED", "PENDING"}


def parse_timestamp(value):
    try:
        parsed = datetime.fromisoformat(value)
    except (ValueError, TypeError):
        raise ValueError(f"Invalid ISO 8601 timestamp: {value!r}") from None
    if parsed.tzinfo is None:
        raise ValueError(f"Timestamp must include timezone information: {value!r}")
    return parsed


def parse_amount(value):
    try:
        amount = Decimal(value)
    except DecimalException:
        raise ValueError(f"Invalid amount: {value!r}") from None
    if not amount.is_finite():
        raise ValueError(f"Amount must be finite: {value!r}")
    return amount


def reconcile(csv_path):
    latest = {}
    with open(csv_path, newline="", encoding="utf-8-sig") as handle:
        # Read raw lines or use csv.reader to strictly check field count and header
        reader = csv.reader(handle)
        try:
            header = next(reader)
        except StopIteration:
            raise ValueError("CSV file is empty")
        
        # Strip header columns
        header = [h.strip() for h in header]
        if header != list(REQUIRED_COLUMNS):
            raise ValueError(f"CSV headers must be {list(REQUIRED_COLUMNS)}, got {header}")
        
        line_num = 1
        for row in reader:
            line_num += 1
            if len(row) != len(REQUIRED_COLUMNS):
                raise ValueError(f"Row on line {line_num} does not contain exactly {len(REQUIRED_COLUMNS)} fields")
            
            tx_id_raw, timestamp_raw, amount_raw, status_raw = row
            
            tx_id = tx_id_raw.strip()
            if not tx_id:
                raise ValueError(f"Empty transaction ID on line {line_num}")
            
            timestamp_str = timestamp_raw.strip()
            timestamp_dt = parse_timestamp(timestamp_str)
            
            amount_str = amount_raw.strip()
            amount = parse_amount(amount_str)
            
            status_str = status_raw.strip().upper()
            if not status_str or status_str not in KNOWN_STATUSES:
                raise ValueError(f"Invalid status on line {line_num}: {status_raw!r}")
            
            # Deduplication rules:
            # Retain record with the most recent timestamp.
            # If two records represent the same point in time (even with different offsets), retain the first record encountered.
            if tx_id not in latest:
                latest[tx_id] = {
                    "timestamp_dt": timestamp_dt,
                    "timestamp_str": timestamp_str,
                    "amount": amount,
                    "status": status_str,
                    "line_num": line_num
                }
            else:
                prev = latest[tx_id]
                if timestamp_dt > prev["timestamp_dt"]:
                    latest[tx_id] = {
                        "timestamp_dt": timestamp_dt,
                        "timestamp_str": timestamp_str,
                        "amount": amount,
                        "status": status_str,
                        "line_num": line_num
                    }
                elif timestamp_dt == prev["timestamp_dt"]:
                    # Same point in time: retain the first record encountered (lower line_num)
                    if line_num < prev["line_num"]:
                        latest[tx_id] = {
                            "timestamp_dt": timestamp_dt,
                            "timestamp_str": timestamp_str,
                            "amount": amount,
                            "status": status_str,
                            "line_num": line_num
                        }

    valid_records = [tx for tx in latest.values() if tx["status"] == "VALID"]
    failed_records = [tx for tx in latest.values() if tx["status"] == "FAILED"]
    
    with localcontext(prec=MAX_PREC):
        total = sum((tx["amount"] for tx in valid_records), Decimal(0))
        total = total.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    if total.is_zero():
        total = total.copy_abs()  # never report negative zero
        
    return total, len(valid_records), len(failed_records)


def main():
    if len(sys.argv) != 2:
        print("Usage: python reconcile.py <input.csv>", file=sys.stderr)
        sys.exit(1)
    csv_path = Path(sys.argv[1])
    if not csv_path.is_file():
        print(f"Error: File not found: {csv_path}", file=sys.stderr)
        sys.exit(1)
    try:
        total, valid_count, failed_count = reconcile(csv_path)
    except (ValueError, DecimalException, OSError, csv.Error) as error:
        print(f"Error processing CSV: {error}", file=sys.stderr)
        sys.exit(1)
    print(f'{{\n  "total_valid_amount": {total:f},\n  "valid_count": {valid_count},'\
          f'\n  "failed_count": {failed_count}\n}}')


if __name__ == "__main__":
    main()
