[96.864499, "o", "cat reconcile.py\r\n\u001b[?2004l\r"]
[96.865272, "o", "#!/usr/bin/env python3\r\n\"\"\"Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON.\"\"\"\r\n\r\nimport csv\r\nimport sys\r\nfrom datetime import datetime\r\nfrom decimal import MAX_PREC, ROUND_HALF_UP, Decimal, DecimalException, localcontext\r\nfrom pathlib import Path\r\n\r\nREQUIRED_COLUMNS = (\"tx_id\", \"timestamp\", \"amount\", \"status\")\r\nKNOWN_STATUSES = {\"VALID\", \"FAILED\", \"PENDING\"}\r\n\r\n\r\ndef parse_timestamp(value):\r\n    try:\r\n        parsed = datetime.fromisoformat(value)\r\n    except (ValueError, TypeError):\r\n        raise ValueError(f\"Invalid ISO 8601 timestamp: {value!r}\") from None\r\n    if parsed.tzinfo is None:\r\n        raise ValueError(f\"Timestamp must include timezone information: {value!r}\")\r\n    return parsed\r\n\r\n\r\ndef parse_amount(value):\r\n    try:\r\n        amount = Decimal(value)\r\n    except DecimalException:\r\n        raise ValueError(f\"Invalid amount: {value!r}\") from None\r\n    if not amount.is_finite():\r\n        raise ValueError(f\"Amount must be finite: {value!r}\")\r\n    return amount\r\n\r\n\r\ndef reconcile(csv_path):\r\n    latest = {}\r\n    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle:\r\n        # Read raw lines or use csv.reader to strictly check field count and header\r\n        reader = csv.reader(handle)\r\n        try:\r\n            header = next(reader)\r\n        except StopIteration:\r\n            raise ValueError(\"CSV file is empty\")\r\n        \r\n        # Strip header columns\r\n        header = [h.strip() for h in header]\r\n        if header != list(REQUIRED_COLUMNS):\r\n            raise ValueError(f\"CSV headers must be {list(REQUIRED_COLUMNS)}, got {header}\")\r\n        \r\n        line_num = 1\r\n        for row in reader:\r\n            line_num += 1\r\n            if len(row) != len(REQUIRED_COLUMNS):\r\n                raise ValueError(f\"Row on line {line_num} does not contain exactly {len(REQUIRED_COLUMNS)} fields\")\r\n            \r\n            tx_id_raw, timestamp_raw, amount_raw, status_raw = row\r\n            \r\n            tx_id = tx_id_raw.strip()\r\n            if not tx_id:\r\n                raise ValueError(f\"Empty transaction ID on line {line_num}\")\r\n            \r\n            timestamp_str = timestamp_raw.strip()\r\n            timestamp_dt = parse_timestamp(timestamp_str)\r\n            \r\n            amount_str = amount_raw.strip()\r\n            amount = parse_amount(amount_str)\r\n            \r\n            status_str = status_raw.strip().upper()\r\n            if not status_str or status_str not in KNOWN_STATUSES:\r\n                raise ValueError(f\"Invalid status on line {line_num}: {status_raw!r}\")\r\n            \r\n            # Deduplication rules:\r\n            # Retain record with the most recent timestamp.\r\n            # If two records represent the same point in time (even with different offsets), retain the first record encountered.\r\n            if tx_id not in latest:\r\n                latest[tx_id] = {\r\n                    \"timestamp_dt\": timestamp_dt,\r\n                    \"timestamp_str\": timestamp_str,\r\n                    \"amount\": amount,\r\n                    \"status\": status_str,\r\n                    \"line_num\": line_num\r\n                }\r\n            else:\r\n                prev = latest[tx_id]\r\n                if timestamp_dt > prev[\"timestamp_dt\"]:\r\n                    latest[tx_id] = {\r\n                        \"timestamp_dt\": timestamp_dt,\r\n                        \"timestamp_str\": timestamp_str,\r\n                        \"amount\": amount,\r\n                        \"status\": status_str,\r\n                        \"line_num\": line_num\r\n                    }\r\n                elif timestamp_dt == prev[\"timestamp_dt\"]:\r\n                    # Same point in time: retain the first record encountered (lower line_num)\r\n                    if line_num < prev[\"line_num\"]:\r\n                        latest[tx_id] = {\r\n                            \"timestamp_dt\": timestamp_dt,\r\n                            \"timestamp_str\": timestamp_str,\r\n                            \"amount\": amount,\r\n                            \"status\": status_str,\r\n                            \"line_num\": line_num\r\n                        }\r\n\r\n    valid"]
[96.865448, "o", "_records = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\r\n    failed_records = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\r\n    \r\n    with localcontext(prec=MAX_PREC):\r\n        total = sum((tx[\"amount\"] for tx in valid_records), Decimal(0))\r\n        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\r\n    if total.is_zero():\r\n        total = total.copy_abs()  # never report negative zero\r\n        \r\n    return total, len(valid_records), len(failed_records)\r\n\r\n\r\ndef main():\r\n    if len(sys.argv) != 2:\r\n        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\r\n        sys.exit(1)\r\n    csv_path = Path(sys.argv[1])\r\n    if not csv_path.is_file():\r\n        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    try:\r\n        total, valid_count, failed_count = reconcile(csv_path)\r\n    except (ValueError, DecimalException, OSError, csv.Error) as error:\r\n        print(f\"Error processing CSV: {error}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    print(f'{{\\n  \"total_valid_amount\": {total:f},\\n  \"valid_count\": {valid_count},'\\\r\n          f'\\n  \"failed_count\": {failed_count}\\n}}')\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@0a0ce012ddfe:/app# "]
[106.377863, "i", "cat << 'EOF' > test_reconcile.py\nimport subprocess\nimport sys\nimport json\nimport tempfile\nimport os\n\ndef run_script(content):\n    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv') as f:\n        f.write(content)\n        fname = f.name\n    try:\n        res = subprocess.run([sys.executable, 'reconcile.py', fname], capture_output=True, text=True)\n        return res.returncode, res.stdout, res.stderr\n    finally:\n        os.unlink(fname)\n\n# Test 1: Basic valid, failed, pending\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00Z,10.50,VALID\\n2,2023-01-01T12:00:00Z,20.00,FAILED\\n3,2023-01-01T12:00:00Z,30.00,PENDING\\n')\nprint(\"Test 1:\", code, json.loads(out) if code == 0 else err)\nassert code == 0\nassert json.loads(out) == {\"total_valid_amount\": 10.50, \"valid_count\": 1, \"failed_count\": 1}\n\n# Test 2: Deduplication with timezones (same point in time different offsets, retain first)\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00+00:00,10.00,VALID\\n1,2023-01-01T07:00:00-05:00,20.00,VALID\\n')\nprint(\"Test 2:\", code, json.loads(out) if code == 0 else err)\nassert code == 0\nassert json.loads(out) == {\"total_valid_amount\": 10.00, \"valid_count\": 1, \"failed_count\": 0}\n\n# Test 3: Deduplication with newer timestamp\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00+00:00,10.00,VALID\\n1,2023-01-01T13:00:00+00:00,20.00,VALID\\n')\nprint(\"Test 3:\", code, json.loads(out) if code == 0 else err)\nassert code == 0\nassert json.loads(out) == {\"total_valid_amount\": 20.00, \"valid_count\": 1, \"failed_count\": 0}\n\n# Test 4: Rounding half up away from zero (2.345 -> 2.35, -2.345 -> -2.35)\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00Z,2.345,VALID\\n')\nprint(\"Test 4:\", code, json.loads(out) if code == 0 else err)\nassert code == 0\nassert json.loads(out) == {\"total_valid_amount\": 2.35, \"valid_count\": 1, \"failed_count\": 0}\n\n# Test 5: Negative zero avoidance (-0.00 -> 0)\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00Z,-0.001,VALID\\n')\nprint(\"Test 5:\", code, json.loads(out) if code == 0 else err)\nassert code == 0\nassert json.loads(out) == {\"total_valid_amount\": 0, \"valid_count\": 1, \"failed_count\": 0}\n\n# Test 6: Invalid row validation (missing fields)\ncode, out, err = run_script('tx_id,timestamp,amount,status\\n1,2023-01-01T12:00:00Z,10.00\\n')\nprint(\"Test 6:\", code, err)\nassert code != 0\n\nprint(\"All tests passed successfully!\")\nEOF\npython3 test_reconcile.py\n"]
