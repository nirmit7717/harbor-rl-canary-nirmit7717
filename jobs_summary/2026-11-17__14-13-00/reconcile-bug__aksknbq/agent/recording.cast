[237.610982, "o", "    assert data[\"valid_count\"] == 1\r\n\u001b[?2004l\r\u001b[?2004h>     assert data[\"failed_count\"] == 1\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Test 1 passed\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.611206, "o", "    # Test 2: Same point in time with different offsets -> retain first\r\n\u001b[?2004l\r\u001b[?2004h>     csv = '''tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> t1,2023-01-01T02:00:00+02:00,100.00,VALID\r\n\u001b[?2004l\r"]
[237.611486, "o", "\u001b[?2004h> t1,2023-01-01T01:00:00+01:00,200.00,VALID\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h>     code, out, err = run_reconcile(csv)\r\n\u001b[?2004l\r"]
[237.611605, "o", "\u001b[?2004h>     assert code == 0, f\"Failed with err: {err}\"\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.loads(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.611765, "o", "    assert data[\"total_valid_amount\"] == 100.00\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Test 2 passed\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.611858, "o", ">     # Test 3: Rounding half up away from zero (-2.345 -> -2.35)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.612001, "o", "    csv = '''tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> t1,2023-01-01T00:00:00Z,-2.345,VALID\r\n\u001b[?2004l\r"]
[237.612121, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.612283, "o", "    code, out, err = run_reconcile(csv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert code == 0, f\"Failed with err: {err}\"\r\n\u001b[?2004l\r"]
[237.612455, "o", "\u001b[?2004h>     data = json.loads(out)\r\n\u001b[?2004l\r\u001b[?2004h>     assert data[\"total_valid_amount\"] == -2.35\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Test 3 passed\")\r\n\u001b[?2004l\r"]
[237.612653, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Test 4: Missing timezone -> error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.612913, "o", "    csv = '''tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> t1,2023-01-01T00:00:00,100.00,VALID\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h>     code, out, err = run_reconcile(csv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert code != 0\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Test 4 passed\")\r\n\u001b[?2004l\r"]
[237.613196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Test 5: Invalid amount (NaN) -> error\r\n\u001b[?2004l\r\u001b[?2004h>     csv = '''tx_id,timestamp,amount,status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.61332, "o", "t1,2023-01-01T00:00:00Z,NaN,VALID\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h>     code, out, err = run_reconcile(csv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert code != 0\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Test 5 passed\")\r\n\u001b[?2004l\r"]
[237.613504, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"All tests passed successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     test_all()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
