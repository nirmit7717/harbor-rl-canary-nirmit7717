[185.672224, "i", "python3 -c '\nwith open(\"test_reconcile.py\", \"w\") as f:\n    f.write(\"\"\"\\\nimport unittest\nimport subprocess\nimport tempfile\nimport json\nfrom pathlib import Path\n\nclass TestReconcile(unittest.TestCase):\n    def run_script(self, csv_content):\n        with tempfile.NamedTemporaryFile(mode=\"w\", delete=False, suffix=\".csv\", encoding=\"utf-8\") as tf:\n            tf.write(csv_content)\n            fname = tf.name\n        try:\n            res = subprocess.run([\"python3\", \"reconcile.py\", fname], capture_output=True, text=True)\n            return res.returncode, res.stdout, res.stderr\n        finally:\n            Path(fname).unlink()\n\n    def test_basic(self):\n        csv = \\\"tx_id,timestamp,amount,status\\\\n1,2023-01-01T10:00:00Z,100.50,VALID\\\\n\\\"\n        code, out, err = self.run_script(csv)\n        self.assertEqual(code, 0)\n        data = json.loads(out)\n        self.assertEqual(data[\\\"total_valid_amount\\\"], 100.50)\n        self.assertEqual(data[\\\"valid_count\\\"], 1)\n        self.assertEqual(data[\\\"failed_count\\\"], 0)\n\nif __name__ == \"__main__\":\n    unittest.main()\n\"\"\")\n'\npython3 test_reconcile.py\n"]
