[250.825406, "i", "python3 -c '\nwith open(\"reconcile.py\", \"w\") as f:\n    f.write(\"\"\"\\\n#!/usr/bin/env python3\n\"\"\"Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON.\"\"\"\n\nimport csv\nimport sys\nfrom datetime import datetime\nfrom decimal import ROUND_HALF_UP, Decimal, DecimalException, localcontext\nfrom pathlib import Path\n\nREQUIRED_COLUMNS = (\"tx_id\", \"timestamp\", \"amount\", \"status\")\nKNOWN_STATUSES = {\"VALID\", \"FAILED\", \"PENDING\"}\n\n\ndef parse_timestamp(value):\n    try:\n        parsed = datetime.fromisoformat(value)\n    except (ValueError, TypeError):\n        raise ValueError(f\"Invalid ISO 8601 timestamp: {value!r}\") from None\n    if parsed.tzinfo is None:\n        raise ValueError(f\"Timestamp must include a UTC offset: {value!r}\")\n    return parsed\n\n\ndef parse_amount(value):\n    try:\n        amount = Decimal(value)\n    except DecimalException:\n        raise ValueError(f\"Invalid amount: {value!r}\") from None\n    if not amount.is_finite():\n        raise ValueError(f\"Amount must be finite: {value!r}\")\n    return amount\n\n\ndef reconcile(csv_path):\n    latest = {}\n    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle:\n        reader = csv.reader(handle)\n        try:\n            header = next(reader)\n        except StopIteration:\n            raise ValueError(\"CSV file is empty\")\n\n        # Strip header columns\n        header = [h.strip() for h in header]\n        if tuple(header) != REQUIRED_COLUMNS:\n            raise ValueError(f\"Invalid header columns: {header!r}\")\n\n        for line_num, row in enumerate(reader, start=2):\n            if len(row) != len(REQUIRED_COLUMNS):\n                raise ValueError(f\"Row on line {line_num} does not have exactly {len(REQUIRED_COLUMNS)} fields\")\n            \n            tx_id_raw, timestamp_raw, amount_raw, status_raw = row\n            \n            tx_id = tx_id_raw.strip()\n            if not tx_id:\n                raise ValueError(f\"Empty transaction ID on line {line_num}\")\n\n            timestamp_dt = parse_timestamp(timestamp_raw.strip())\n            amount = parse_amount(amount_raw.strip())\n            status = status_raw.strip().upper()\n\n            if status not in KNOWN_STATUSES:\n                raise ValueError(f\"Unknown status on line {line_num}: {status_raw!r}\")\n\n            previous = latest.get(tx_id)\n            if previous is None or timestamp_dt > previous[\"timestamp_dt\"]:\n                latest[tx_id] = {\n                    \"timestamp_dt\": timestamp_dt,\n                    \"amount\": amount,\n                    \"status\": status\n                }\n\n    valid_txs = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\n    failed_txs = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\n\n    with localcontext():\n        total = sum((tx[\"amount\"], for tx in valid_txs), Decimal(0))\n        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n\n    if total.is_zero():\n        total = total.copy_abs()\n\n    return total, len(valid_txs), len(failed_txs)\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\n        sys.exit(1)\n    csv_path = Path(sys.argv[1])\n    if not csv_path.is_file():\n        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\n        sys.exit(1)\n    try:\n        total, valid_count, failed_count = reconcile(csv_path)\n    except (ValueError, DecimalException, OSError, csv.Error) as error:\n        print(f\"Error processing CSV: {error}\", file=sys.stderr)\n        sys.exit(1)\n\n    print(f\\\"{\\n  \\\"total_valid_amount\\\": {total:f},\\n  \\\"valid_count\\\": {valid_count},\\n  \\\"failed_count\\\": {failed_count}\\n}\\\")\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\")\n'\npython3 test_reconcile.py\n"]
