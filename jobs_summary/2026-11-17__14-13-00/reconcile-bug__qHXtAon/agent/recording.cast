[250.830268, "o", "    valid_txs = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\r\n\u001b[?2004l\r\u001b[?2004h>     failed_txs = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\r\n\u001b[?2004l\r"]
