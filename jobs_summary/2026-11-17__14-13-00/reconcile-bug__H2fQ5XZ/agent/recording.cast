[53.49541, "i", "cat << 'EOF' > reconcile.py\n#!/usr/bin/env python3\n\"\"\"Summarise a transaction CSV (tx_id,timestamp,amount,status) as JSON.\"\"\"\n\nimport csv\nimport sys\nfrom datetime import datetime\nfrom decimal import MAX_PREC, ROUND_HALF_UP, Decimal, DecimalException, localcontext\nfrom pathlib import Path\n\nREQUIRED_COLUMNS = (\"tx_id\", \"timestamp\", \"amount\", \"status\")\nKNOWN_STATUSES = {\"VALID\", \"FAILED\", \"PENDING\"}\n\n\ndef parse_timestamp(value):\n    try:\n        parsed = datetime.fromisoformat(value)\n    except Exception as e:\n        raise ValueError(f\"Invalid ISO 8601 timestamp: {value!r}\") from e\n    if parsed.tzinfo is None:\n        raise ValueError(f\"Timestamp must include a UTC offset: {value!r}\")\n    return parsed\n\n\ndef parse_amount(value):\n    try:\n        amount = Decimal(value)\n    except DecimalException:\n        raise ValueError(f\"Invalid amount: {value!r}\") from None\n    if not amount.is_finite():\n        raise ValueError(f\"Amount must be finite: {value!r}\")\n    return amount\n\n\ndef reconcile(csv_path):\n    latest = {}\n    with open(csv_path, newline=\"\", encoding=\"utf-8-sig\") as handle: \n        reader = csv.reader(handle)\n        try:\n            header = next(reader)\n        except StopIteration:\n            raise ValueError(\"CSV file is empty\")\n        \n        if tuple(header) != REQUIRED_COLUMNS:\n            raise ValueError(\"CSV is missing required columns or has incorrect headers\")\n\n        line_num = 1\n        for row in reader:\n            line_num += 1\n            if len(row) != len(REQUIRED_COLUMNS):\n                raise ValueError(f\"Row {line_num} does not contain exactly {len(REQUIRED_COLUMNS)} fields\")\n            \n            tx_id, timestamp_str, amount_str, status_str = row\n            tx_id = tx_id.strip()\n            timestamp_str = timestamp_str.strip()\n            amount_str = amount_str.strip()\n            status_str = status_str.strip()\n\n            if not tx_id:\n                raise ValueError(f\"Empty transaction ID on line {line_num}\")\n\n            dt = parse_timestamp(timestamp_str)\n            amount = parse_amount(amount_str)\n            \n            status = status_str.upper()\n            if status not in KNOWN_STATUSES:\n                raise ValueError(f\"Unknown status on line {line_num}: {status_str!r}\")\n\n            record = {\n                \"datetime\": dt,\n                \"amount\": amount,\n                \"status\": status,\n                \"line_num\": line_num\n            }\n\n            previous = latest.get(tx_id)\n            if previous is None:\n                latest[tx_id] = record\n            else:\n                if dt > previous[\"datetime\"]:\n                    latest[tx_id] = record\n                elif dt == previous[\"datetime\"]:\n                    # Tie: retain the first record encountered in the input file (smaller line_num)\n                    if record[\"line_num\"] < previous[\"line_num\"]:\n                        latest[tx_id] = record\n\n    valid_txs = [tx for tx in latest.values() if tx[\"status\"] == \"VALID\"]\n    failed_txs = [tx for tx in latest.values() if tx[\"status\"] == \"FAILED\"]\n\n    with localcontext(prec=MAX_PREC):\n        total = sum((tx[\"amount\"], for tx in valid_txs), Decimal(0))\n        total = total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n\n    if total.is_zero():\n        total = total.copy_abs()\n\n    return total, len(valid_txs), len(failed_txs)\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: python reconcile.py <input.csv>\", file=sys.stderr)\n        sys.exit(1)\n    csv_path = Path(sys.argv[1])\n    if not csv_path.is_file():\n        print(f\"Error: File not found: {csv_path}\", file=sys.stderr)\n        sys.exit(1)\n    try:\n        total, valid_count, failed_count = reconcile(csv_path)\n    except (ValueError, DecimalException, OSError, csv.Error) as error:\n        print(f\"Error processing CSV: {error}\", file=sys.stderr)\n        sys.exit(1)\n    print(f'{{\\n  \"total_valid_amount\": {total:f},\\n  \"valid_count\": {valid_count},'\n          f'\\n  \"failed_count\": {failed_count}\\n}}')\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\npython3 test_reconcile.py\n"]
[53.495676, "o", "cat << 'EOF' > reconcile.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
