[102.622832, "i", "cat << 'EOF' > test_reconcile.py\nimport unittest\nimport subprocess\nimport tempfile\nimport os\nimport json\n\nclass TestReconcile(unittest.TestCase):\n    def run_reconcile(self, csv_content):\n        with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.csv', encoding='utf-8') as f:\n            f.write(csv_content)\n            fname = f.name\n        try:\n            res = subprocess.run(['python3', 'reconcile.py', fname], capture_output=True, text=True)\n            return res.returncode, res.stdout, res.stderr\n        finally:\n            os.unlink(fname)\n\n    def test_basic_and_pending(self):\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"1,2023-01-01T00:00:00+00:00,100.50,VALID\\n\"\n            \"2,2023-01-01T01:00:00+00:00,50.00,PENDING\\n\"\n            \"3,2023-01-01T02:00:00+00:00,20.00,FAILED\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertEqual(code, 0, err)\n        data = json.loads(out)\n        self.assertEqual(data[\"valid_count\"], 1)\n        self.assertEqual(data[\"failed_count\"], 1)\n        self.assertEqual(data[\"total_valid_amount\"], 100.5)\n\n    def test_deduplication_timezone_tie(self):\n        # Same point in time with different offsets: 10:00+02:00 equals 09:00+01:00 equals 08:00+00:00\n        # First encountered should be retained.\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"t1,2023-01-01T10:00:00+02:00,100.00,VALID\\n\"\n            \"t1,2023-01-01T09:00:00+01:00,200.00,VALID\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertEqual(code, 0, err)\n        data = json.loads(out)\n        self.assertEqual(data[\"total_valid_amount\"], 100.00)\n\n    def test_deduplication_newer_timestamp(self):\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"t1,2023-01-01T08:00:00+00:00,100.00,VALID\\n\"\n            \"t1,2023-01-01T09:00:00+00:00,150.00,VALID\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertEqual(code, 0, err)\n        data = json.loads(out)\n        self.assertEqual(data[\"total_valid_amount\"], 150.00)\n\n    def test_rounding_half_up(self):\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"1,2023-01-01T00:00:00+00:00,2.345,VALID\\n\"\n            \"2,2023-01-01T00:00:00+00:00,-2.345,VALID\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertEqual(code, 0, err)\n        data = json.loads(out)\n        self.assertEqual(data[\"total_valid_amount\"], 0.0)\n\n    def test_validation_missing_tz(self):\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"1,2023-01-01T00:00:00,100.00,VALID\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertNotEqual(code, 0)\n\n    def test_validation_invalid_amount(self):\n        csv = (\n            \"tx_id,timestamp,amount,status\\n\"\n            \"1,2023-01-01T00:00:00+00:00,NaN,VALID\\n\"\n        )\n        code, out, err = self.run_reconcile(csv)\n        self.assertNotEqual(code, 0)\n\nif __name__ == '__main__':\n    unittest.main()\nEOF\npython3 test_reconcile.py\n"]
