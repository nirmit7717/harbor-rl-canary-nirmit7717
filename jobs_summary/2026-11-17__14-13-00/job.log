Sending keys: ['cat << \'EOF\' > test_reconcile.py\nimport subprocess\nimport sys\nimport tempfile\nimport os\nimport json\n\ndef run_reconcile(csv_content):\n    with tempfile.NamedTemporaryFile(mode=\'w\', delete=False, suffix=\'.csv\', encoding=\'utf-8\') as f:\n        f.write(csv_content)\n        fname = f.name\n    try:\n        res = subprocess.run([sys.executable, \'reconcile.py\', fname], capture_output=True, text=True)\n        return res.returncode, res.stdout, res.stderr\n    finally:\n        os.unlink(fname)\n\ndef test_all():\n    # Test 1: Basic deduplication and status filtering\n    csv = \'\'\'tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00Z,100.00,VALID\nt1,2023-01-01T01:00:00Z,150.00,VALID\nt2,2023-01-01T00:00:00Z,50.00,FAILED\nt3,2023-01-01T00:00:00Z,200.00,PENDING\n\'\'\'\n    code, out, err = run_reconcile(csv)\n    assert code == 0, f"Failed with err: {err}"\n    data = json.loads(out)\n    assert data["total_valid_amount"] == 150.00\n    assert data["valid_count"] == 1\n    assert data["failed_count"] == 1\n    print("Test 1 passed")\n\n    # Test 2: Same point in time with different offsets -> retain first\n    csv = \'\'\'tx_id,timestamp,amount,status\nt1,2023-01-01T02:00:00+02:00,100.00,VALID\nt1,2023-01-01T01:00:00+01:00,200.00,VALID\n\'\'\'\n    code, out, err = run_reconcile(csv)\n    assert code == 0, f"Failed with err: {err}"\n    data = json.loads(out)\n    assert data["total_valid_amount"] == 100.00\n    print("Test 2 passed")\n\n    # Test 3: Rounding half up away from zero (-2.345 -> -2.35)\n    csv = \'\'\'tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00Z,-2.345,VALID\n\'\'\'\n    code, out, err = run_reconcile(csv)\n    assert code == 0, f"Failed with err: {err}"\n    data = json.loads(out)\n    assert data["total_valid_amount"] == -2.35\n    print("Test 3 passed")\n\n    # Test 4: Missing timezone -> error\n    csv = \'\'\'tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00,100.00,VALID\n\'\'\'\n    code, out, err = run_reconcile(csv)\n    assert code != 0\n    print("Test 4 passed")\n\n    # Test 5: Invalid amount (NaN) -> error\n    csv = \'\'\'tx_id,timestamp,amount,status\nt1,2023-01-01T00:00:00Z,NaN,VALID\n\'\'\'\n    code, out, err = run_reconcile(csv)\n    assert code != 0\n    print("Test 5 passed")\n\n    print("All tests passed successfully!")\n\nif __name__ == \'__main__\':\n    test_all()\nEOF\npython3 test_reconcile.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
